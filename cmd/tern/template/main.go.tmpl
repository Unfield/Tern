package main

import (
	"log"

	"github.com/Unfield/Tern/kit"
)

func main() {
	// ternApp is generated by `tern gen` (and `tern dev` / `tern build`) in
	// tern.gen.go. Options such as kit.WithHook and kit.WithMiddleware
	// configure the app.
	app, err := ternApp(kit.WithHook(func(ctx *kit.Ctx) error {
		ctx.SetHeader("X-Frame-Options", "DENY")
		return nil
	}))
	if err != nil {
		log.Fatal(err)
	}
	if err := app.ListenAndServe(); err != nil {
		log.Fatal(err)
	}
}
