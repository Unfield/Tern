{
	"components": {
		"schemas": {
			"Ask": {
				"properties": {
					"question": {
						"type": "string"
					}
				},
				"required": [
					"question"
				],
				"type": "object"
			},
			"Delta": {
				"properties": {
					"text": {
						"type": "string"
					}
				},
				"required": [
					"text"
				],
				"type": "object"
			},
			"Error": {
				"properties": {
					"message": {
						"type": "string"
					}
				},
				"required": [
					"message"
				],
				"type": "object"
			}
		}
	},
	"info": {
		"title": "API",
		"version": "1.0.0"
	},
	"openapi": "3.1.0",
	"paths": {
		"/api/ask": {
			"get": {
				"operationId": "getApiAsk",
				"responses": {
					"200": {
						"content": {
							"text/event-stream": {
								"schema": {
									"type": "string"
								},
								"x-item-schema": {
									"$ref": "#/components/schemas/Delta"
								}
							}
						},
						"description": "Server-sent events: each event's data is a JSON value of x-item-schema. The stream ends with a done event, or an error event whose data is an Error."
					},
					"default": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						},
						"description": "An error"
					}
				}
			},
			"post": {
				"operationId": "postApiAsk",
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/Ask"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"content": {
							"text/event-stream": {
								"schema": {
									"type": "string"
								},
								"x-item-schema": {
									"$ref": "#/components/schemas/Delta"
								}
							}
						},
						"description": "Server-sent events: each event's data is a JSON value of x-item-schema. The stream ends with a done event, or an error event whose data is an Error."
					},
					"default": {
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/Error"
								}
							}
						},
						"description": "An error"
					}
				}
			}
		}
	}
}
