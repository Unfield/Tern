# Copy to .env and fill in. Only BASE_URL matters in production; the rest
# turn features on.
BASE_URL=http://localhost:5173
DATABASE_PATH=app.db
APP_NAME={{.Name}}

# Email. Without SMTP_HOST, emails go to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=

# Sign-in with GitHub and Google.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_SECRET=

# Billing with Stripe: the secret key, the webhook's secret (from the
# endpoint's settings, or from stripe listen in development), and the
# prices' IDs. Without the key, everyone is on the free plan.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

TRUSTED_PROXIES=
