package routes

import (
	"github.com/Unfield/Tern/accounts"
	"github.com/Unfield/Tern/kit"
)

// Session is who is signed in, for every page: nil when no one is.
type Session struct {
	User *accounts.User `json:"user"`
}

func LayoutLoad(ctx *kit.Ctx) (Session, error) {
	return Session{User: accounts.Current(ctx)}, nil
}
