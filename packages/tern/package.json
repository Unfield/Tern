{
  "name": "@ternkit/tern",
  "version": "0.0.0",
  "description": "Client runtime and Vite plugin for Tern: Svelte on the client, Go on the server",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Unfield/Tern.git",
    "directory": "packages/tern"
  },
  "homepage": "https://github.com/Unfield/Tern",
  "bugs": "https://github.com/Unfield/Tern/issues",
  "keywords": [
    "svelte",
    "go",
    "framework",
    "vite",
    "router"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/runtime/client.d.ts",
      "svelte": "./dist/runtime/client.js",
      "default": "./dist/runtime/client.js"
    },
    "./goscript": {
      "types": "./dist/goscript/index.svelte.d.ts",
      "svelte": "./dist/goscript/index.svelte.js",
      "default": "./dist/goscript/index.svelte.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "svelte": "./dist/ui/index.js",
      "default": "./dist/ui/index.js"
    },
    "./ui/theme.css": "./dist/ui/theme.css",
    "./server": {
      "types": "./dist/server/index.d.ts",
      "svelte": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./polyfills": {
      "types": "./dist/server/polyfills.d.ts",
      "default": "./dist/server/polyfills.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "prepare": "svelte-package -i src -o dist",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run"
  },
  "peerDependencies": {
    "sharp": ">=0.33.0",
    "svelte": "^5.46.4",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "acorn": "^8.19.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.2",
    "@types/node": "^24.0.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  }
}
