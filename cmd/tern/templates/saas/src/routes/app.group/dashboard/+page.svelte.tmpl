<h1>Dashboard</h1>
<p class="lead">What’s in your account.</p>

{#if !data.emailVerified}
	<Alert tone="warning" title="Confirm your email address">
		We sent you a link. Didn’t get it?
		<Form action="?/verify" reset={false} class="inline">
			<Button type="submit" variant="secondary" size="sm">Send it again</Button>
		</Form>
		{#if (form as { sent?: boolean } | null)?.sent}<span role="status">Sent: check your inbox.</span>{/if}
	</Alert>
{/if}

<div class="stats">
	<Stat label="Projects" value={data.projects} />
	<Stat label="Signed-in devices" value={data.devices} />
	<Stat label="Passkeys" value={data.passkeys} />
</div>

<div class="grid">
	<Card title="Recent projects" level={2}>
		{#snippet actions()}<Button href="/projects" variant="ghost" size="sm">All projects</Button>{/snippet}
		{#if data.recent.length}
			<ul class="list">
				{#each data.recent as p (p.id)}
					<li><a href="/projects#project-{p.id}">{p.name}</a><span>{date(p.updatedAt)}</span></li>
				{/each}
			</ul>
		{:else}
			<Empty title="No projects yet" description="Projects are where your users’ work goes. Create the first one.">
