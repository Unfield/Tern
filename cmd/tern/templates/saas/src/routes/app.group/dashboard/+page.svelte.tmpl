	</Card>

	<Card title="Getting started" level={2}>
		{#if left.length === 0}
			<p class="done">You’re all set up.</p>
		{/if}
		<ul class="list steps">
			{#each data.steps as s (s.label)}
				<li>
					{#if s.done}<span class="label">{s.label}</span><Badge tone="success">Done</Badge>{:else}<a href={s.href}>{s.label}</a><Badge>To do</Badge>{/if}
				</li>
			{/each}
		</ul>
	</Card>
