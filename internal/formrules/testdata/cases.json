{
	"fields": {
		"name": { "name": "name", "label": "Project name", "kind": "string", "required": true, "rules": [{ "name": "min", "arg": "3" }, { "name": "max", "arg": "20" }] },
		"slug": { "name": "slug", "label": "Slug", "kind": "string", "rules": [{ "name": "pattern", "arg": "[a-z0-9]+(-[a-z0-9]+)*" }] },
		"code": { "name": "code", "label": "Code", "kind": "string", "rules": [{ "name": "len", "arg": "1" }] },
		"email": { "name": "email", "label": "Email", "kind": "string", "required": true, "rules": [{ "name": "email" }] },
		"site": { "name": "site", "label": "Website", "kind": "string", "rules": [{ "name": "url" }] },
		"seats": { "name": "seats", "label": "Seats", "kind": "int", "required": true, "rules": [{ "name": "min", "arg": "1" }, { "name": "max", "arg": "500" }] },
		"price": { "name": "price", "label": "Price", "kind": "float", "rules": [{ "name": "min", "arg": "0.5" }] },
		"plan": { "name": "plan", "label": "Plan", "kind": "string", "rules": [{ "name": "oneof", "arg": "free|team|enterprise" }] },
		"terms": { "name": "terms", "label": "Terms", "kind": "bool", "required": true },
		"start": { "name": "start", "label": "Start date", "kind": "date", "rules": [{ "name": "min", "arg": "2026-01-01" }, { "name": "max", "arg": "2026-12-31" }] },
		"meet": { "name": "meet", "label": "Meeting", "kind": "datetime", "rules": [{ "name": "min", "arg": "2026-01-01T09:00" }] },
		"tags": { "name": "tags", "label": "Tags", "kind": "strings", "required": true, "rules": [{ "name": "max", "arg": "2" }, { "name": "oneof", "arg": "go|svelte|sql" }] },
		"password": { "name": "password", "label": "Password", "kind": "string", "required": true, "secret": true, "rules": [{ "name": "min", "arg": "8" }] },
		"confirm": { "name": "confirm", "label": "Confirm password", "kind": "string", "required": true, "secret": true, "rules": [{ "name": "same", "arg": "password" }] },
		"handle": { "name": "handle", "label": "Handle", "kind": "string", "rules": [{ "name": "pattern", "arg": "[a-z]+" }], "message": "Use lowercase letters only." }
	},
