package invitation

import (
	"errors"
	"net/http"

	"github.com/Unfield/Tern/accounts"
	"github.com/Unfield/Tern/kit"

	"{{.Module}}/internal/app"
)

type Page struct {
	Invitation *accounts.Invitation `json:"invitation"`
	Token      string               `json:"token"`
	// Email is the signed-in user's, or nil when signed out.
	Email *string `json:"email"`
}

// Load shows the invitation an email links to: to accept signed in with
// the invited address, or to sign up or in first.
func Load(ctx *kit.Ctx) (Page, error) {
	token := ctx.URL().Query().Get("token")
	p := Page{Token: token}
	inv, err := app.Current.Accounts.InvitationFor(ctx.Request.Context(), token)
	if err != nil && !errors.Is(err, accounts.ErrInvalidToken) {
		return Page{}, err
	}
	p.Invitation = inv
	if u := accounts.Current(ctx); u != nil {
		p.Email = &u.Email
	}
	return p, nil
}

type Accept struct {
	Token string `form:"token" validate:"required"`
}

var Actions = kit.Actions{
	"accept": kit.FormAction(func(ctx *kit.Ctx, in Accept) (struct{}, error) {
		if _, err := app.Current.Accounts.Require(ctx); err != nil {
			return struct{}{}, err
		}
		if _, err := app.Current.Accounts.AcceptInvitation(ctx, in.Token); err != nil {
			return struct{}{}, accounts.FormError(ctx, err)
		}
		return struct{}{}, kit.Redirect(http.StatusSeeOther, "/dashboard")
	}),
}
