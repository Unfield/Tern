package code

import (
	"net/http"

	"github.com/Unfield/Tern/accounts"
	"github.com/Unfield/Tern/kit"

	"{{.Module}}/internal/app"
)

type Page struct {
	Next string `json:"next"`
}

// Load is the page after a password that needs a code: without one
// waiting, it sends the user back to sign in.
func Load(ctx *kit.Ctx) (Page, error) {
	if !app.Current.Accounts.AwaitingCode(ctx) {
		return Page{}, kit.Redirect(http.StatusSeeOther, "/login")
	}
	return Page{Next: app.SafeNext(ctx.URL().Query().Get("next"))}, nil
}

type Code struct {
	Code string `form:"code" validate:"required,max=20" label:"Code"`
}

var Actions = kit.Actions{
	"default": kit.FormAction(func(ctx *kit.Ctx, in Code) (struct{}, error) {
		if _, err := app.Current.Accounts.CompleteSignIn(ctx, in.Code); err != nil {
			return struct{}{}, accounts.FormError(ctx, err)
		}
		return struct{}{}, kit.Redirect(http.StatusSeeOther, app.SafeNext(ctx.URL().Query().Get("next")))
	}),
}
